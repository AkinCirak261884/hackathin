{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["api/**", "analysis/**", "data/risk-radar-export.csv"] }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "api/index.py" }],
  "regions": ["arn1"]
}
