{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "leaderboard.schema.json",
  "title": "GET /leaderboard?panel=TCD (peer view). Shape = Lane A analysis/leaderboard.py leaderboard(con, viewer_token)",
  "type": "object",
  "required": ["min_resolved", "entries", "n_not_yet_ranked"],
  "properties": {
    "min_resolved": { "type": "integer" },
    "shrink_k": { "type": "integer" },
    "acaps_mapping": { "const": "midpoint" },
    "group_mean_brier": { "type": "number" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rank", "display_name", "n_resolved", "shrunk_brier", "mean_brier", "acaps_brier_same_questions", "super_estimator", "is_you"],
        "properties": {
          "rank": { "type": "integer" },
          "display_name": { "type": "string", "description": "pseudonym, or 'Anonymous expert'. Never a name or token" },
          "n_resolved": { "type": "integer" },
          "shrunk_brier": { "type": "number", "description": "ranking score: few-forecast scores pulled toward the group mean" },
          "mean_brier": { "type": "number" },
          "acaps_brier_same_questions": { "type": "number" },
          "super_estimator": { "type": "boolean" },
          "is_you": { "type": "boolean" }
        }
      }
    },
    "n_not_yet_ranked": { "type": "integer" }
  }
}
